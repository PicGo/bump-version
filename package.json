{
  "name": "@picgo/bump-version",
  "version": "2.1.0",
  "description": "",
  "main": "index.js",
  "bin": {
    "bump-version": "./bin/bump-version"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "cz": "git-cz",
    "release": "node ./bin/bump-version",
    "lint": "eslint --ext .js .",
    "lint:fix": "eslint --ext .js --fix .",
    "test:watch": "vitest"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PicGo/bump-version"
  },
  "author": "Molunerfinn",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PicGo/bump-version/issues"
  },
  "homepage": "https://github.com/PicGo/bump-version#readme",
  "devDependencies": {
    "@commitlint/cli": "^7.5.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "commitizen": "^4.2.3",
    "cz-customizable": "^7.5.1",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-promise": "^7.2.1",
    "husky": "^1.3.1",
    "vitest": "^4.1.11"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.js"
    }
  },
  "commitlint": {
    "extends": [
      "./commitlint-picgo"
    ]
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "compare-func": "^2.0.0",
    "conventional-changelog": "^3.0.6",
    "inquirer": "^13.0.2",
    "minimist": "^1.2.8",
    "ora": "^3.4.0",
    "semver": "^7.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
