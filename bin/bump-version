#!/usr/bin/env node
import minimist from 'minimist'
import semver from 'semver'
import path from 'node:path'
import fs from 'node:fs'
import { Separator } from '@inquirer/prompts'
import inquirer from 'inquirer'
import logger from '../src/logger.js'
import mainLifeCycle from '../src/mainLifeCycle.js'
import resolveVersion, { releaseTypes } from '../src/resolveVersion.js'
import * as utils from '../src/utils.js'

let pkg
try {
  pkg = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'package.json'), 'utf8'))
} catch (e) {
  logger('package.json not found!', 'error')
  process.exit(0)
}
let argv = minimist(process.argv.slice(2), {
  alias: {
    'preid-alpha': 'a', // alpha
    'preid-beta': 'b', // beta
    'dry': 'd', // dry run mode
    'file': 'f', // changelog file,
    'path': 'p', // package.json's path
    'help': 'h', // help message
    'type': 't', // bump type
    'yes': 'y' // skip prompts
  },
  // Without this, `--version 1.0.0-beta.1` is parsed as a number and loses
  // everything after the first dot.
  string: ['version', 'type', 'file', 'path']
})

if (argv.h) {
  console.log(utils.helperMsg)
  process.exit(0)
}

let currentVersion = pkg.version
if (currentVersion === undefined) {
  logger('Version field is not found in package.json!', 'error')
  process.exit(0)
}
let preid = argv.a ? 'alpha' : argv.b ? 'beta' : ''

let resolved = resolveVersion(argv, currentVersion)
if (resolved.error) {
  logger(resolved.error, 'error')
  process.exit(1)
}
let nextVersion = resolved.version

function generateReleaseTypes (types) {
  return types.map(item => {
    let version = semver.inc(currentVersion, item, (preid || 'alpha'))
    return {
      name: `${item} - ${version}`,
      value: version
    }
  })
}

let defaultObj = {
  path: process.cwd(),
  file: 'CHANGELOG.md'
}

argv = Object.assign({}, defaultObj, argv)

let promptList = [
  {
    type: 'confirm',
    name: 'confirmVersion',
    message: `The next version is ${nextVersion}, is it right?`
  }
]
console.log(
  `
BumpVersion -- By PicGo Group
  `
);
(async () => {
  // Non-interactive path: no prompt is written at all, so this works with no
  // TTY attached (CI, `pnpm release` from a script, an agent session).
  if (argv.yes) {
    console.log(`Bumping ${currentVersion} -> ${nextVersion}${argv.dry ? ' (dry run)' : ''}`)
    await mainLifeCycle(argv, currentVersion, nextVersion)
    return
  }

  let answer = await inquirer.prompt(promptList)
  if (answer.confirmVersion) {
    await mainLifeCycle(argv, currentVersion, nextVersion)
  } else {
    promptList = [
      {
        type: 'select',
        name: 'version',
        message: `The current version is ${currentVersion}\n Which version would you like to bump it?`,
        choices: [
          ...generateReleaseTypes(releaseTypes),
          new Separator(),
          'custom version',
          'never mind~'
        ],
        pageSize: 10
      }
    ]
    let answer = await inquirer.prompt(promptList)
    if (answer.version === 'never mind~') {
      return console.log('Bye~')
    } else if (answer.version === 'custom version') {
      promptList = [
        {
          type: 'input',
          name: 'version',
          message: 'Write down your custom version:'
        }
      ]
      let result = await inquirer.prompt(promptList)
      // Same validator as --version, so a typed version and a flagged one are
      // held to one rule.
      let custom = resolveVersion({ version: result.version }, currentVersion)
      if (custom.error) {
        return logger(custom.error, 'error')
      }
      await mainLifeCycle(argv, currentVersion, custom.version)
    } else {
      await mainLifeCycle(argv, currentVersion, answer.version)
    }
  }
})()
